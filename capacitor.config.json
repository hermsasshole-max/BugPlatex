{
  "appId": "com.splatdex.app",
  "appName": "SplatDex",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}
